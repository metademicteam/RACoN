# RACoN Environment Configuration (Template)
# Copy to .env and change every secret before exposing the server beyond your tailnet.
# This file is read by BOTH the desktop app and the Docker Compose stack, so it must not
# contain container-only paths such as /data or /models.

# Authentication & Security
# Protects the web UI, the admin dashboard and every /api/v1 call.
AUTH_TOKEN=replace-with-a-long-random-admin-token
# Limited-scope token compiled into the desktop/web client. Not the admin token.
RACON_CLIENT_TOKEN=replace-with-a-long-random-client-token
RACON_DEV_MODE=false

# Desktop / local engine binding (the Docker Compose file overrides this to 0.0.0.0
# inside the container, where the port is published by Docker).
RACON_HOST=127.0.0.1
RACON_PORT=8765
RACON_CORS_ORIGINS=http://127.0.0.1:1420,http://localhost:1420,http://127.0.0.1:8765,http://localhost:8765

# Worker admission (server side)
RACON_AUTO_APPROVE_WORKERS=true
RACON_JOIN_CODE=RCN-PUBLIC-JOIN

# A worker points at the server. Use the server host's Tailscale IP for remote machines.
RACON_COORDINATOR_URL=http://127.0.0.1:8765

# PostgreSQL (docker compose builds DATABASE_URL from these; ignored by the desktop app)
POSTGRES_USER=racon
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=racon

# Model downloads (Hugging Face token only for gated repositories)
HF_TOKEN=

# Local runtime for the desktop app. The server container pins RACON_RUNTIME=llama_cpp
# (it ships llama-server) regardless of this value; set RACON_SERVER_RUNTIME=ollama only
# if you deliberately want the container to use an Ollama daemon on the host.
# RACON_RUNTIME=llama_cpp
# RACON_SERVER_RUNTIME=llama_cpp
# OLLAMA_URL=http://127.0.0.1:11434

# Optional shared registry (read-only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Tailscale: run Tailscale on the Windows host (not in a sidecar). Workers then use
# http://<host-tailscale-ip>:8765.
