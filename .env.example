# RACoN Environment Configuration (Template)

# Authentication & Security
AUTH_TOKEN=generate-with-secrets-token-urlsafe
RACON_DEV_MODE=false

# Network Binding & CORS (Coordinator Ingress)
RACON_HOST=127.0.0.1
RACON_PORT=8765
RACON_CORS_ORIGINS=http://127.0.0.1:1420

# Local Runtimes
OLLAMA_URL=http://127.0.0.1:11434

# Cloud Synchronization (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-key

# Tailscale Sidecar (Optional for Docker profile: tailscale)
TS_AUTHKEY=tskey-auth-your-key-here
TS_HOSTNAME=racon-coordinator
