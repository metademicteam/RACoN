# RACoN Environment Configuration (Template)
# Copy to .env and change every secret before exposing the server beyond your tailnet.
# This file is read by BOTH the desktop app and the Docker Compose stack, so it must not
# contain container-only paths such as /data or /models.

# Authentication & Security
# Protects the web UI, the admin dashboard and every /api/v1 call.
AUTH_TOKEN=replace-with-a-long-random-admin-token
# Limited-scope token compiled into the desktop/web client. Not the admin token.
RACON_CLIENT_TOKEN=replace-with-a-long-random-client-token
RACON_DEV_MODE=false

# Desktop / local engine binding (the Docker Compose file overrides this to 0.0.0.0
# inside the container, where the port is published by Docker).
RACON_HOST=127.0.0.1
RACON_PORT=8765
RACON_CORS_ORIGINS=http://127.0.0.1:1420,http://localhost:1420,http://127.0.0.1:8765,http://localhost:8765

# Worker admission (server side)
RACON_AUTO_APPROVE_WORKERS=true
RACON_JOIN_CODE=RCN-PUBLIC-JOIN

# A worker points at the server. Use the server host's Tailscale IP for remote machines.
RACON_COORDINATOR_URL=http://127.0.0.1:8765

# PostgreSQL (docker compose builds DATABASE_URL from these; ignored by the desktop app)
POSTGRES_USER=racon
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=racon

# Model downloads (Hugging Face token only for gated repositories)
HF_TOKEN=

# Together AI agentic scheduler (server-side only; never ship this key to clients).
# When enabled, model "racon" is classified by the decision model; normal chat is answered
# by the agent model, and task requests are planned with tool calls, distributed to online
# workers, then merged and reviewed with a low token budget.
# TOGETHER_ENABLED=true
# TOGETHER_API_KEY=
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# TOGETHER_DECISION_MODEL=together/Tev1-4B-experimental
# TOGETHER_AGENT_MODEL=MiniMaxAI/MiniMax-M3.1-Flash
# 'none' disables hidden reasoning so normal chat returns immediately.
# TOGETHER_REASONING_EFFORT=none
# TOGETHER_TIMEOUT_S=90
# TOGETHER_DECISION_MAX_TOKENS=96
# TOGETHER_AGENT_MAX_TOKENS=2048
# RACON_AGENTIC_MAX_TASKS=6
# RACON_AGENTIC_MAX_PARALLEL=4
# RACON_AGENTIC_MERGE_MAX_TOKENS=2048
# Preferred worker model; empty picks the fastest advertised model on each node.
# RACON_AGENTIC_WORKER_MODEL=

# Public address embedded in installers and used by the desktop client. Keep the host
# reachable from user machines (Tailscale Funnel or a reverse proxy both work).
RACON_PUBLIC_URL=https://desktop-b7l73cl.tail6cb521.ts.net

# Local runtime for the desktop app. The server container pins RACON_RUNTIME=llama_cpp
# (it ships llama-server) regardless of this value; set RACON_SERVER_RUNTIME=ollama only
# if you deliberately want the container to use an Ollama daemon on the host.
# RACON_RUNTIME=llama_cpp
# RACON_SERVER_RUNTIME=llama_cpp
# In-process fallback when llama.cpp is missing or Ollama is not running.
# RACON_FALLBACK_RUNTIME=mistralrs
# RACON_MISTRALRS_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# RACON_MISTRALRS_QUANT=4
# OLLAMA_URL=http://127.0.0.1:11434
# Context window for llama.cpp and Ollama workers (tokens). The runtime caps it at each
# model's trained GGUF context. Set the same value on the coordinator and every worker;
# the server API accepts up to 262144.
# RACON_CONTEXT_SIZE=262144
# KV cache element type (q8_0 shrinks a long context to about half of f16). Requires a
# llama.cpp build with flash attention support.
# RACON_KV_CACHE_TYPE=q8_0
# Thinking/reasoning models otherwise spend the output budget before answering. off is the
# safe default for chat; set on (or auto) when you deliberately want reasoning output.
# RACON_REASONING=off
# Full GPU offload is used only when the GGUF fits measured VRAM. Set 0 to force CPU.
# RACON_AUTO_GPU_LAYERS=1

# Optional shared registry (read-only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Tailscale: run Tailscale on the Windows host (not in a sidecar). Workers then use
# http://<host-tailscale-ip>:8765.
